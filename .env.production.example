# Copy to .env.production on the server only. Never commit the real file.
# Generate the password with: openssl rand -hex 32   (hex: safe inside a URL)

# The version to run is not set here: deploy.sh receives it for each deployment.
APP_BASE_PATH=/mercurio
LOG_LEVEL=info

POSTGRES_USER=mercurio
POSTGRES_PASSWORD=change-me
# Password of mercurio_app, the role the API runs as (different from the owner's).
POSTGRES_APP_PASSWORD=change-me
POSTGRES_DB=mercurio
