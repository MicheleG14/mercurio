{
  "name": "mercurio",
  "version": "0.0.0",
  "private": true,
  "description": "Mercurio: warehouse and invoicing modular monolith (NestJS + React)",
  "license": "MIT",
  "author": "Michele Ginolfi",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "dev:api": "pnpm --filter @mercurio/api start:dev",
    "dev:web": "pnpm --filter @mercurio/web dev",
    "generate": "pnpm --filter @mercurio/api generate",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @mercurio/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,md,yml,yaml,html}": "prettier --write",
    "apps/api/{src,test}/**/*.ts": "pnpm --filter @mercurio/api exec oxlint -c .oxlintrc.json",
    "apps/web/src/**/*.{ts,tsx}": "pnpm --filter @mercurio/web exec oxlint -c .oxlintrc.json"
  }
}
