  "info": {
    "title": "Mercurio API",
    "description": "Warehouse and invoicing",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mercurio_refresh"
      }
    },
    "schemas": {
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "tenantIsolation": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "description": "Down when the database role could bypass Row-Level Security"
          }
        },
        "required": [
          "database",
          "tenantIsolation"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          },
          "uptimeSeconds": {
            "type": "number",
            "description": "Seconds since the process started",
            "example": 42
          },
          "timestamp": {
            "type": "string",
            "example": "2026-10-19T15:00:00.000Z"
          }
        },
        "required": [
          "status",
          "checks",
          "version",
          "uptimeSeconds",
          "timestamp"
        ]
      },
      "AuditActorDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "AuditEventDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "example": "2026-10-20T15:00:00.000Z"
          },
          "type": {
            "type": "string",
            "example": "MEMBER_ADDED"
          },
          "source": {
            "type": "string",
            "enum": [
              "API",
              "CLI"
            ]
          },
          "actor": {
            "nullable": true,
            "description": "Empty for the terminal operator",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/AuditActorDto"
              }
            ]
          },
          "subjectType": {
            "type": "string",
            "nullable": true
          },
          "subjectId": {
            "type": "string",
            "nullable": true
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true,
            "description": "Small structured facts about the event, never secrets"
          }
        },
        "required": [
          "id",
          "at",
          "type",
          "source",
          "actor"
        ]
      },
      "AuditEventPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEventDto"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ]
      },
      "ActivateDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The one-time activation code received from the administrator"
          },
          "password": {
            "type": "string",
            "description": "The new password, 12 to 128 characters"
          }
        },
        "required": [
          "code",
          "password"
        ]
      },
      "ActivateResponseDto": {
        "type": "object",
        "properties": {
          "enrollToken": {
            "type": "string"
          }
        },
        "required": [
          "enrollToken"
        ]
      },
      "EnrollStartDto": {
        "type": "object",
        "properties": {
          "enrollToken": {
            "type": "string",
            "description": "The enrollment token returned by the activation"
          }
        },
        "required": [
          "enrollToken"
        ]
      },
      "EnrollStartResponseDto": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "The secret in base32, for typing into an app by hand"
          },
          "uri": {
            "type": "string",
            "description": "The otpauth:// address to show as a QR code"
          }
        },
        "required": [
          "secret",
          "uri"
        ]
      },
      "EnrollConfirmDto": {
        "type": "object",
        "properties": {
          "enrollToken": {
            "type": "string",
            "description": "The enrollment token returned by the activation"
          },
          "code": {
            "type": "string",
            "example": "123456",
            "description": "The six-digit code shown by the app"
          }
        },
        "required": [
          "enrollToken",
          "code"
        ]
      },
      "TenantChoiceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "WAREHOUSE_KEEPER",
              "ACCOUNTANT",
              "READ_ONLY"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role"
        ]
      },
      "EnrollConfirmResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Send as \"Authorization: Bearer <token>\""
          },
          "expiresIn": {
            "type": "number",
            "description": "Seconds until the access token expires"
          },
          "tenantId": {
            "type": "string",
            "nullable": true,
            "description": "The tenant of the session; empty until chosen"
          },
          "tenants": {
            "description": "Tenants the person can choose from",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TenantChoiceDto"
            }
          },
          "recoveryCodes": {
            "description": "Shown once: the person must save them",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "tenantId",
          "tenants",
          "recoveryCodes"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "mario@example.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "MFA_REQUIRED",
              "ENROLLMENT_REQUIRED"
            ],
            "description": "MFA_REQUIRED: send the challenge token with a code to /auth/mfa/verify. ENROLLMENT_REQUIRED: the two-factor setup was never finished; use the enrollment token."
          },
          "token": {
            "type": "string",
            "description": "Challenge token or enrollment token, according to status"
          }
        },
        "required": [
          "status",
          "token"
        ]
      },
      "VerifyMfaDto": {
        "type": "object",
        "properties": {
          "challengeToken": {
            "type": "string",
            "description": "The challenge token returned by the login"
          },
          "code": {
            "type": "string",
            "description": "A six-digit code, or a recovery code",
            "example": "123456"
          }
        },
        "required": [
          "challengeToken",
          "code"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Send as \"Authorization: Bearer <token>\""
          },
          "expiresIn": {
            "type": "number",
            "description": "Seconds until the access token expires"
          },
          "tenantId": {
            "type": "string",
            "nullable": true,
            "description": "The tenant of the session; empty until chosen"
          },
          "tenants": {
            "description": "Tenants the person can choose from",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TenantChoiceDto"
            }
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "tenantId",
          "tenants"
        ]
      },
      "SelectTenantDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          }
        },
        "required": [
          "tenantId"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "RegenerateRecoveryCodesDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "123456",
            "description": "A current six-digit code"
          }
        },
        "required": [
          "password",
          "code"
        ]
      },
      "RecoveryCodesDto": {
        "type": "object",
        "properties": {
          "recoveryCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "recoveryCodes"
        ]
      },
      "MeUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ]
      },
      "MeTenantDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "MeCompanyDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "legalName": {
            "type": "string"
          },
          "vatNumber": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "legalName",
          "vatNumber"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/MeUserDto"
          },
          "tenant": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/MeTenantDto"
              }
            ]
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "permissions": {
