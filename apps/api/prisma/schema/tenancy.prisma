// Module `tenancy`: the customers of the platform (tenants), their companies and the
// modules each tenant has enabled. Tables with tenant_id are protected by Row-Level Security.

/// A customer of the platform: whoever holds the subscription. Never deleted (B10).
model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  /// Lowercase identifier used by terminal commands, e.g. `rossi`.
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  companies   Company[]
  modules     TenantModule[]
  memberships Membership[]
  roles       TenantRole[]
  sessions    Session[]
  auditEvents AuditEvent[]
  parties     Party[]
  items       Item[]

  warehouses             Warehouse[]
  stockDocuments         StockDocument[]
  stockMovements         StockMovement[]
  stockBalances          StockBalance[]
  reorderLevels          ReorderLevel[]
  stockDocumentCounters  StockDocumentCounter[]
  stockReservations      StockReservation[]
  orders                 Order[]
  orderLines             OrderLine[]
  orderFulfilments       OrderFulfilment[]
  orderFulfilmentLines   OrderFulfilmentLine[]
  orderCounters          OrderCounter[]
  invoiceableFulfilments InvoiceableFulfilment[]
  invoiceableLines       InvoiceableLine[]
  invoiceDrafts          InvoiceDraft[]
  invoiceDraftLines      InvoiceDraftLine[]
  invoices               Invoice[]
  invoiceLines           InvoiceLine[]
  invoiceVatRows         InvoiceVatRow[]
  invoiceCounters        InvoiceCounter[]
  invoiceDueDates        InvoiceDueDate[]
  payments               Payment[]
  paymentAllocations     PaymentAllocation[]
  creditAllocations      CreditAllocation[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED

  @@map("tenant_status")
}

/// A legal entity of a tenant (its own VAT number, invoice numbering, warehouses).
/// The header data an invoice prints is optional here and required to issue one (phase 5).
model Company {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  legalName       String   @map("legal_name")
  vatNumber       String   @map("vat_number")
  taxCode         String?  @map("tax_code")
  /// ISO 3166-1 alpha-2.
  country         String   @default("IT") @db.Char(2)
  /// Registered office.
  address         String?
  postalCode      String?  @map("postal_code")
  city            String?
  province        String?  @db.Char(2)
  /// Register of companies (REA): the province of the office and the number.
  reaOffice       String?  @map("rea_office") @db.Char(2)
  reaNumber       String?  @map("rea_number")
  /// Share capital, for companies that print it.
  shareCapital    Decimal? @map("share_capital") @db.Decimal(14, 2)
  /// One shareholder (true), several (false), not a company with shares (empty).
  soleShareholder Boolean? @map("sole_shareholder")
  inLiquidation   Boolean  @default(false) @map("in_liquidation")
  /// Tax regime from the catalog (RF01 ordinary).
  taxRegime       String   @default("RF01") @map("tax_regime")
  /// Where customers pay by bank transfer.
  iban            String?
  email           String?
  pecEmail        String?  @map("pec_email")
  phone           String?
  /// Whether the stamp duty of exempt invoices is charged to the customer (phase 5).
  chargeStampDuty Boolean  @default(true) @map("charge_stamp_duty")
  /// Optimistic concurrency (B29) for the header data.
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  membershipCompanies    MembershipCompany[]
  warehouses             Warehouse[]
  stockCounters          StockDocumentCounter[]
  orders                 Order[]
  orderCounters          OrderCounter[]
  invoiceableFulfilments InvoiceableFulfilment[]
  invoiceDrafts          InvoiceDraft[]
  invoices               Invoice[]
  invoiceCounters        InvoiceCounter[]
  payments               Payment[]

  /// Target of composite foreign keys: a reference can never cross tenants (B25).
  @@unique([tenantId, id])
  @@unique([tenantId, vatNumber])
  @@map("companies")
}

/// A module a tenant has enabled. Keys are validated against the module catalog in code.
model TenantModule {
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleKey String   @map("module_key")
  enabledAt DateTime @default(now()) @map("enabled_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, moduleKey])
  @@map("tenant_modules")
}
