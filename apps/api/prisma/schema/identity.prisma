// Module `identity`: people (one identity each, S4), their memberships in tenants with a
// role and the companies they can reach, and one-time activation codes.

/// A person. The same identity can belong to several tenants through memberships.
model User {
  id        String     @id @default(uuid(7)) @db.Uuid
  /// Stored lowercase and trimmed (checked by the database).
  email     String     @unique
  name      String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships      Membership[]
  activationTokens ActivationToken[]
  credential       Credential?
  recoveryCodes    RecoveryCode[]
  sessions         Session[]
  authEvents       AuthEvent[]
  auditEvents      AuditEvent[]
  stockDocuments   StockDocument[]
  orders           Order[]
  orderFulfilments OrderFulfilment[]
  invoiceDrafts    InvoiceDraft[]    @relation("InvoiceDraftCreator")
  invoicesIssued   Invoice[]         @relation("InvoiceIssuer")
  payments         Payment[]         @relation("PaymentCreator")

  @@map("users")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// A user's place in a tenant: role and reachable companies. Never deleted: REMOVED instead.
/// The role is either a built-in one (`role`) or one the tenant defined (`customRoleId`), never
/// both and never neither (checked by the database).
model Membership {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  role         MembershipRole?
  customRoleId String?          @map("custom_role_id") @db.Uuid
  status       MembershipStatus @default(ACTIVE)
  /// True: every company of the tenant. False: only those in membership_companies.
  allCompanies Boolean          @default(false) @map("all_companies")
  /// Optimistic concurrency (B29) for role and companies.
  version      Int              @default(1)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  user       User                @relation(fields: [userId], references: [id])
  customRole TenantRole?         @relation(fields: [tenantId, customRoleId], references: [tenantId, id])
  companies  MembershipCompany[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@map("memberships")
}

enum MembershipRole {
  ADMIN
  WAREHOUSE_KEEPER
  ACCOUNTANT
  READ_ONLY

  @@map("membership_role")
}

enum MembershipStatus {
  ACTIVE
  REMOVED

  @@map("membership_status")
}

/// A role a tenant defined for itself: a name and a set of permissions, validated against the
/// catalog in code. Built-in roles are not rows: they live in code (ROLE_PERMISSIONS) and get new
/// permissions with each release; a custom role never does by itself.
model TenantRole {
  id          String          @id @default(uuid(7)) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  name        String
  description String?
  permissions String[]
  /// The built-in role it was duplicated from, for information only.
  basedOn     MembershipRole? @map("based_on")
  version     Int             @default(1)
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  memberships Membership[]

  /// Target of composite foreign keys: a membership never points to another tenant's role (B25).
  @@unique([tenantId, id])
  @@map("tenant_roles")
}

/// Companies reachable by a membership with allCompanies = false. Both foreign keys include
/// tenant_id, so a membership can only reach companies of its own tenant (B25).
model MembershipCompany {
  tenantId     String @map("tenant_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  companyId    String @map("company_id") @db.Uuid

  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id])
  company    Company    @relation(fields: [tenantId, companyId], references: [tenantId, id])

  @@id([membershipId, companyId])
  @@map("membership_companies")
}

/// One-time code to activate an identity (set a password and MFA, from phase 1b).
/// Only the SHA-256 hash is stored; the API role has no access at all.
model ActivationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("activation_tokens")
}
