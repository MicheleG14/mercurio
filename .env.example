# Copy to .env for local development. Never commit the real .env.

# --- API ---
NODE_ENV=development
PORT=3000
# Prefix the whole app lives under. Empty = served from the root (local development).
# In production: /mercurio
APP_BASE_PATH=
LOG_LEVEL=info

# --- Database (docker compose up -d db, then pnpm db:setup) ---
# Owner role: migrations, terminal commands, seeds. Never used by the running API.
POSTGRES_USER=mercurio
POSTGRES_PASSWORD=mercurio
POSTGRES_DB=mercurio
DATABASE_ADMIN_URL=postgresql://mercurio:mercurio@127.0.0.1:5432/mercurio
# API role (mercurio_app): subject to Row-Level Security. pnpm db:setup creates its login.
POSTGRES_APP_PASSWORD=mercurio-app-dev-password
DATABASE_URL=postgresql://mercurio_app:mercurio-app-dev-password@127.0.0.1:5432/mercurio
